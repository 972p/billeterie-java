<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.admin.AdminTransactionsController" spacing="20" alignment="CENTER" style="-fx-padding: 30; -fx-background-color: transparent;">

    <Label text="Historique des Transactions" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <!-- FILTRE -->
    <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 10 0 10;">
        <Label text="Rechercher un client :" style="-fx-text-fill: white; -fx-font-size: 14; -fx-font-weight: bold;"/>
        <TextField fx:id="txtRecherche" prefWidth="300" promptText="Nom du client, email..."/>
    </HBox>

    <TableView fx:id="transactions_table" VBox.vgrow="ALWAYS" 
               style="-fx-background-color: #2b2b3c; -fx-background-radius: 10; -fx-border-color: rgba(187,134,252,0.3); -fx-border-radius: 10; -fx-padding: 5;">
        <columns>
            <TableColumn fx:id="colDate" text="Date &amp; Heure d'Achat" prefWidth="150" />
            <TableColumn fx:id="colStatut" text="Statut" prefWidth="120" />
            <TableColumn fx:id="colClient" text="Client" prefWidth="200" />
            <TableColumn fx:id="colNbBillets" text="Nombre de Billets" prefWidth="150" />
            <TableColumn fx:id="colTotal" text="Total (€)" prefWidth="120" />
            <TableColumn fx:id="colAction" text="Détails" prefWidth="150" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
